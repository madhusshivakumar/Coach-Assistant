# Copy to .env and customize. Never commit .env.

# Data root. All data/* subdirectories live under this path.
FA_DATA_DIR=./data

# Logging level: DEBUG / INFO / WARNING / ERROR
FA_LOG_LEVEL=INFO

# Force UTF-8 on Windows (prevents cp1252 surprises).
PYTHONUTF8=1

# Optional: StatsBomb commercial API (NOT required for POC — open data only)
# STATSBOMB_USERNAME=
# STATSBOMB_PASSWORD=
